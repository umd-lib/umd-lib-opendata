[
  {
    "id": "refresh",
    "execute-command": "/scripts/refresh.py",
    "command-working-directory": "/tmp",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{ getenv "GIT_REPO_WEBHOOK_SECRET" }}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    },
    "pass-environment-to-command":
    [
      {
        "source": "payload",
        "name": "ref",
        "envname": "HOOK_ref"
      },
      {
        "source": "payload",
        "name": "repository.clone_url",
        "envname": "HOOK_repository_clone_url"
      },
      {
        "source": "header",
        "name": "x-hub-signature-256",
        "envname": "HOOK_signature"
      }
    ]
  },
  {
    "id": "ready",
    "execute-command": "/bin/true",
    "response-message": "OK\n"
  }
]